    <script>
        function switchStore(storeId) {
            const sections = document.querySelectorAll('.store-section');
            sections.forEach(sec => sec.classList.add('hidden'));
            document.getElementById(storeId).classList.remove('hidden');

            const tabs = document.querySelectorAll('.store-tab');
            tabs.forEach(tab => {
                tab.classList.remove('bg-red-600', 'text-white', 'shadow');
                tab.classList.add('bg-white', 'text-gray-700', 'hover:bg-gray-200');
            });

            event.currentTarget.classList.remove('bg-white', 'text-gray-700', 'hover:bg-gray-200');
            event.currentTarget.classList.add('bg-red-600', 'text-white', 'shadow');
        }
    </script>
